# Prediction Data Pipeline - Environment Configuration

# S3 bucket for bronze layer data (required)
BRONZE_BUCKET=bronze-bucket-name
SILVER_BUCKET=silver-bucket-name

# AWS region for S3 operations (default: us-east-1)
AWS_REGION=us-east-1

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO


KALSHI_API_KEY_ID=kalshi-api-key
KALSHI_PRIVATE_KEY_PATH=kalshi-private-key-path
JWT_SECRET=jwt-secret

POLYGON_WALLET_ADDRESS=polygon-wallet-address
POLYGON_WALLET_PUBLIC_KEY=polygon-wallet-public-key
POLYGON_WALLET_PRIVATE_KEY=polygon-wallet-private-key
POLYMARKET_BUILDER_API_KEY=polymarket-builder-api-key
POLYMARKET_BUILDER_SECRET=polymarket-builder-secret
POLYMARKET_BUILDER_PASSPHRASE=polymarket-builder-passphrase

# PostgreSQL (for API user data - defaults match docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=predmkts
POSTGRES_PASSWORD=predmkts
POSTGRES_DATABASE=predmkts

# JWT Authentication (CHANGE jwt_secret in production!)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ClickHouse - Gold layer serving database
# Local development (docker-compose):
#   CLICKHOUSE_HOST=localhost
#   CLICKHOUSE_PORT=8123
#   CLICKHOUSE_USER=default
#   CLICKHOUSE_PASSWORD=
#   CLICKHOUSE_DATABASE=prediction_gold
#
# ClickHouse Cloud (port 8443 enables TLS automatically):
#   CLICKHOUSE_HOST=abc123xyz.us-east-1.aws.clickhouse.cloud
#   CLICKHOUSE_PORT=8443
#   CLICKHOUSE_USER=default
#   CLICKHOUSE_PASSWORD=your-password
#   CLICKHOUSE_DATABASE=prediction_gold
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=prediction_gold

DATABASE_URL=database-url

# API Debug Mode (exposes stack traces in error responses - set to false in production!)
DEBUG=false

# CORS Origins (comma-separated list of allowed origins)
# Use "*" for development, specific origins for production
# Examples:
#   CORS_ORIGINS=*                                      # Allow all (development only)
#   CORS_ORIGINS=https://myapp.com                      # Single origin
#   CORS_ORIGINS=https://myapp.com,https://admin.myapp.com  # Multiple origins
CORS_ORIGINS=*

