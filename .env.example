# Prediction Data Pipeline - Environment Configuration

# S3 bucket for bronze layer data (required)
BRONZE_BUCKET=your-bronze-bucket-name

# AWS region for S3 operations (default: us-east-1)
AWS_REGION=us-east-1

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO


KALSHI_API_KEY_ID=kalshi-api-key
KALSHI_PRIVATE_KEY_PATH=kalshi-private-key-path

POLYGON_WALLET_ADDRESS=polygon-wallet-address
POLYGON_WALLET_PUBLIC_KEY=polygon-wallet-public-key
POLYGON_WALLET_PRIVATE_KEY=polygon-wallet-private-key
POLYMARKET_BUILDER_API_KEY=polymarket-builder-api-key
POLYMARKET_BUILDER_SECRET=polymarket-builder-secret
POLYMARKET_BUILDER_PASSPHRASE=polymarket-builder-passphrase
